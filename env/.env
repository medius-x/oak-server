# ───────────────────────────────────────────────────────────────────────
# OAK — local dev environment variables.
# Consumed by docker-compose.yml in the same directory.
# These are DEV defaults only — override before any real deployment.
# ───────────────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=oak
POSTGRES_PASSWORD=oakpass
POSTGRES_DB=oak
POSTGRES_PORT=5432

# MinIO (root password must be >= 8 chars)
MINIO_ROOT_USER=oak_minio
MINIO_ROOT_PASSWORD=oak_minio_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Janus
JANUS_REST_PORT=8088
JANUS_WS_PORT=8188
JANUS_ADMIN_PORT=7088
JANUS_ADMIN_SECRET=janus_admin_secret

# Coturn — static long-term credentials handed to WebRTC clients
TURN_REALM=oak.local
TURN_USER=oak
TURN_PASSWORD=oakturn123
# IP clients should use to reach Coturn. 127.0.0.1 = clients on the same host.
# For LAN/remote testing set this to the host's reachable IP (auto: leave as is).
TURN_EXTERNAL_IP=127.0.0.1
TURN_LISTEN_PORT=34780
TURN_TLS_PORT=5349
# Relay UDP port range — keep in sync with the mapped range in docker-compose.yml.
TURN_MIN_PORT=55000
TURN_MAX_PORT=55050
