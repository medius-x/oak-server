# ───────────────────────────────────────────────────────────────────────
# OAK — environment variables template.
#
# Copy to `.env` next to this file and EDIT THE SECRETS before the first
# `docker compose up`:
#     cp .env.example .env
#     # then generate each secret, e.g.:  openssl rand -hex 32
#
# `.env` is GIT-IGNORED on purpose (see oak-server/.gitignore): every
# deployment must carry its OWN secrets. oak-server (spring-boot:run on the
# host) reads this same file via spring.config.import in application-dev.yml,
# so the Spring side and the compose side can never drift apart.
#
# Dev-only WARNING: ports below are host-mapped for the host-run dev topology
# (oak-server on the host). For any LAN/production deployment do NOT expose
# 7088 (Janus admin), 9001 (MinIO console) — and put a TLS proxy in front.
# ───────────────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=oak
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=oak
POSTGRES_PORT=5432

# MinIO (root password must be >= 8 chars). The root credentials are for the
# MinIO console/bootstrap only — oak-server itself uses the scoped app user
# below (created by the one-shot `minio-init` compose service, bucket-only
# policy, no admin).
MINIO_ROOT_USER=oak_minio
MINIO_ROOT_PASSWORD=change-me-minio-root
MINIO_APP_USER=oak_app
MINIO_APP_PASSWORD=change-me-minio-app
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Janus — the admin secret guards the Admin API on :7088 (token minting!) AND
# derives every videoroom pin/secret via HMAC inside oak-server, so it must be
# unique per deployment and never committed.
JANUS_REST_PORT=8088
JANUS_WS_PORT=8188
JANUS_ADMIN_PORT=7088
JANUS_ADMIN_SECRET=change-me-janus-admin

# Coturn — short-lived REST-API credentials (--use-auth-secret): oak-server
# signs per-request time-boxed tickets with this secret; there is no static
# user/password anymore.
TURN_REALM=oak.local
TURN_STATIC_AUTH_SECRET=change-me-turn-static-auth
# IP clients should use to reach Coturn (the host's reachable LAN IP).
TURN_EXTERNAL_IP=192.168.0.78
TURN_LISTEN_PORT=34780
TURN_TLS_PORT=5349
# Relay UDP port range — keep in sync with the mapped range in docker-compose.yml.
TURN_MIN_PORT=55000
TURN_MAX_PORT=55050
